    "@react-native-google-signin/google-signin": "16.1.2",
    "@react-native-vector-icons/fontawesome": "^13.1.2",
    "@react-native-vector-icons/ionicons": "^13.1.2",
    "@shopify/flash-list": "2.3.2",
    "@supabase/supabase-js": "^2.108.2",
    "@tanstack/query-sync-storage-persister": "^5.101.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-query-persist-client": "^5.101.0",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "expo": "~58.0.19",
    "expo-apple-authentication": "~58.0.2",
    "expo-application": "~58.1.2",
    "expo-auth-session": "~58.0.14",
    "expo-build-properties": "~58.0.11",
    "expo-camera": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.15",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-localization": "~58.0.5",
    "expo-navigation-bar": "~58.0.4",
    "expo-notifications": "~58.1.6",
    "expo-print": "~58.0.7",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.20",
    "expo-splash-screen": "~58.0.11",
    "expo-store-review": "~58.0.2",
    "expo-system-ui": "~58.0.6",
    "expo-tracking-transparency": "~58.0.2",
    "expo-updates": "~58.0.18",
    "expo-web-browser": "~58.0.6",
    "posthog-react-native": "^4.54.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.79.0",
    "react-native": "0.88.0",
    "react-native-country-picker-modal": "^2.0.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-google-places-autocomplete": "^2.6.4",
    "react-native-mmkv": "4.3.1",
    "react-native-nitro-modules": "0.35.9",
    "react-native-pager-view": "9.0.7",
    "react-native-phone-number-input": "2.1.0",
    "react-native-purchases": "10.4.2",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/plugin-transform-arrow-functions": "^7.29.7",
    "@babel/plugin-transform-optional-chaining": "^7.29.7",
    "@babel/plugin-transform-shorthand-properties": "^7.29.7",
    "@babel/plugin-transform-template-literals": "^7.29.7",
    "@posthog/cli": "^0.7.34",
    "@react-native/metro-config": "0.88.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^29.1.1",
    "react-native-svg-transformer": "^1.5.3",
    "react-test-renderer": "19.3.0",
    "sharp": "0.35.5",
    "tsx": "4.22.4",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.11"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "@react-native-async-storage/async-storage",
        "@shopify/flash-list",
        "react-native-gesture-handler",
        "react-native-reanimated",
        "react-native-safe-area-context",
        "react-native-svg",
        "react-native-web",
        "react-native-worklets",
        "typescript"
      ]
    },
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false,
        "reason": "Hybrid CNG: release CI regenerates android/ios from app.config.ts via expo prebuild --clean; the committed native projects exist only for fast local dev (expo run). Expo Doctor cannot sync dynamic app.config.ts fields into the committed copies, so this check stays disabled; the prebuild path is the release source of truth."
      }
    }
  }
}
