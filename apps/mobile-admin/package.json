{
  "name": "baci-mobile-admin",
  "main": "index.js",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --dev-client --scheme baciadmin",
    "dev": "pnpm run start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:preview": "eas build --profile preview --platform all",
    "build:ios": "eas build --profile production --platform ios",
    "build:android": "eas build --profile production --platform android",
    "build:all": "eas build --profile production --platform all",
    "submit:ios": "eas submit --platform ios",
    "submit:android": "eas submit --platform android",
    "submit:all": "eas submit --platform all",
    "android:emulator": "bash ./scripts/launch-android-emulator.sh",
    "android:install": "bash ./scripts/install-android-debug.sh",
    "android:metro": "expo start --dev-client --scheme baciadmin --host lan --port 8081",
    "android:launch": "bash ./scripts/launch-android-dev-client.sh",
    "check:platform-drift": "node ./scripts/check-platform-drift.mjs",
    "check:module-size": "node ./scripts/check-module-size.mjs",
    "lint": "biome check .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@baci/shared": "workspace:*",
    "@baci/tiktok-business": "workspace:*",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/dom-webview": "^57.0.1",
    "@expo/metro-runtime": "~57.0.12",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@hookform/resolvers": "^5.4.0",
    "@posthog/react-native-plugin": "^2.1.1",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-google-signin/google-signin": "16.1.2",
    "@react-native-vector-icons/fontawesome": "^13.1.2",
    "@react-native-vector-icons/ionicons": "^13.1.2",
    "@shopify/flash-list": "2.3.2",
    "@supabase/supabase-js": "^2.108.2",
    "@tanstack/query-sync-storage-persister": "^5.101.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-query-persist-client": "^5.101.0",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "expo": "~57.0.15",
    "expo-apple-authentication": "~57.0.1",
    "expo-application": "~57.0.2",
    "expo-auth-session": "~57.0.8",
    "expo-build-properties": "~57.0.13",
    "expo-camera": "~57.0.4",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.13",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.14",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.5",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image-picker": "~57.0.12",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.7",
    "expo-localization": "~57.0.1",
    "expo-navigation-bar": "~57.0.2",
    "expo-notifications": "~57.0.13",
    "expo-print": "~57.0.1",
    "expo-router": "~57.0.15",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.14",
    "expo-splash-screen": "~57.0.7",
    "expo-store-review": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "expo-tracking-transparency": "~57.0.1",
    "expo-updates": "~57.0.16",
    "expo-web-browser": "~57.0.2",
    "posthog-react-native": "^4.54.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.79.0",
    "react-native": "0.86.2",
    "react-native-country-picker-modal": "^2.0.0",
    "react-native-gesture-handler": "~3.0.1",
    "react-native-google-places-autocomplete": "^2.6.4",
    "react-native-mmkv": "4.3.1",
    "react-native-nitro-modules": "0.35.9",
    "react-native-pager-view": "8.0.2",
    "react-native-phone-number-input": "2.1.0",
    "react-native-purchases": "10.4.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.8.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.5",
    "react-native-web": "~0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/plugin-transform-arrow-functions": "^7.29.7",
    "@babel/plugin-transform-optional-chaining": "^7.29.7",
    "@babel/plugin-transform-shorthand-properties": "^7.29.7",
    "@babel/plugin-transform-template-literals": "^7.29.7",
    "@posthog/cli": "^0.7.34",
    "@react-native/metro-config": "0.86.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@vitejs/plugin-react": "^6.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^29.1.1",
    "react-native-svg-transformer": "^1.5.3",
    "react-test-renderer": "19.2.3",
    "sharp": "0.35.4",
    "tsx": "4.22.4",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "@react-native-async-storage/async-storage",
        "@shopify/flash-list",
        "react-native-gesture-handler",
        "react-native-reanimated",
        "react-native-safe-area-context",
        "react-native-svg",
        "react-native-web",
        "react-native-worklets",
        "typescript"
      ]
    },
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false,
        "reason": "Hybrid CNG: release CI regenerates android/ios from app.config.ts via expo prebuild --clean; the committed native projects exist only for fast local dev (expo run). Expo Doctor cannot sync dynamic app.config.ts fields into the committed copies, so this check stays disabled; the prebuild path is the release source of truth."
      }
    }
  }
}
