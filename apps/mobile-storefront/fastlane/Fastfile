default_platform(:ios)

require "English"

WORKSPACE = "ios/Ogabassey.xcworkspace"
SCHEME = "Ogabassey"
BUNDLE_ID = "com.ogabassey.app"
OUTPUT_DIR = File.expand_path("../build", __dir__)
DEFAULT_ATT_REVIEW_NOTES = <<~NOTES.freeze
  App Tracking Transparency review path:
  On a fresh install, launch the app and wait for the animated startup splash to finish. The native ATT prompt appears automatically on the first visible storefront screen; no login or navigation is required. If this device has reviewed an earlier build, delete the app before reinstalling because iOS preserves the previous one-time ATT decision across updates. Advertising SDK initialization and advertising conversion tracking remain disabled unless the user selects Allow.
NOTES

# Frees App Store Connect's single editable-version slot before set_changelog.
# `import` resolves relative to this Fastfile and evaluates in the same context,
# so the helpers below are available to every lane (`require_relative` cannot be
# used here: fastlane evaluates the Fastfile through `eval`, which leaves Ruby
# with no basepath to resolve against).
import("asc_version_slot.rb")

def ensure_required_env!(keys)
  missing = keys.select { |key| ENV[key].to_s.strip.empty? }
  return if missing.empty?

  UI.user_error!(
    "Missing required build environment variables: #{missing.join(', ')}. " \
    "These values must be present during xcodebuild so Expo can embed the storefront release JS bundle correctly."
  )
end

def ensure_any_required_env!(keys)
  return if keys.any? { |key| !ENV[key].to_s.strip.empty? }

  UI.user_error!(
    "Missing required build environment variable: one of #{keys.join(', ')}. " \
    "These values must be present during xcodebuild so Expo can embed the storefront release JS bundle correctly."
  )
end

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_API_KEY_ID"),
    issuer_id: ENV.fetch("ASC_API_ISSUER_ID"),
    key_filepath: ENV.fetch("ASC_API_KEY_PATH"),
    duration: 1200,
    in_house: false
  )
end

def update_app_review_notes!(notes, app_version:)
  UI.user_error!("App Review notes must not exceed 4000 bytes") if notes.bytesize > 4000

  app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
  UI.user_error!("Could not find App Store Connect app #{BUNDLE_ID}") unless app

  version = app.get_edit_app_store_version(
    platform: Spaceship::ConnectAPI::Platform::IOS
  )
  UI.user_error!("Could not find an editable iOS App Store version") unless version
  if !app_version.empty? && version.version_string != app_version
    UI.user_error!(
      "Editable App Store version is #{version.version_string}, not requested #{app_version}"
    )
  end

  review_detail = version.fetch_app_store_review_detail
  UI.user_error!("Configure App Review contact information in App Store Connect first") unless review_detail
  missing_contact_fields = {
    "first name" => review_detail.contact_first_name,
    "last name" => review_detail.contact_last_name,
    "phone" => review_detail.contact_phone,
    "email" => review_detail.contact_email
  }.select { |_name, value| value.to_s.strip.empty? }.keys
  unless missing_contact_fields.empty?
    UI.user_error!("Missing App Review contact fields: #{missing_contact_fields.join(', ')}")
  end

  UI.message("Updating App Review notes without replacing existing attachments")
  review_detail.update(attributes: { notes: notes })
end

def upload_ipa_with_altool!(ipa_path, wait_for_processing:)
  absolute_ipa_path = File.expand_path(ipa_path)
  UI.user_error!("Expected IPA does not exist: #{absolute_ipa_path}") unless File.file?(absolute_ipa_path)

  ensure_required_env!(%w[
    ASC_API_KEY_ID
    ASC_API_ISSUER_ID
    ASC_API_KEY_PATH
  ])

  key_path = File.expand_path(ENV.fetch("ASC_API_KEY_PATH"))
  UI.user_error!("ASC_API_KEY_PATH does not exist: #{key_path}") unless File.file?(key_path)

  UI.message("Uploading #{absolute_ipa_path} to TestFlight with xcrun altool")

  command = [
    "xcrun",
    "altool",
    "--upload-app",
    "--file",
    absolute_ipa_path,
    "--type",
    "ios",
    "--apiKey",
    ENV.fetch("ASC_API_KEY_ID"),
    "--apiIssuer",
    ENV.fetch("ASC_API_ISSUER_ID"),
    "--output-format",
    "normal",
    "--show-progress"
  ]
  command << "--wait" if wait_for_processing

  system({ "API_PRIVATE_KEYS_DIR" => File.dirname(key_path) }, *command)
  status = $CHILD_STATUS
  return if status&.success?

  UI.user_error!("altool upload failed with exit status #{status&.exitstatus || 'unknown'}")
end

platform :ios do
  before_all do
    setup_ci if ENV["CI"]
  end

  desc "Build signed IPA and upload to TestFlight (no review submission)"
  lane :release do
    api_key = asc_api_key
    ensure_required_env!(%w[
      EXPO_PUBLIC_SUPABASE_URL
      EXPO_PUBLIC_API_URL
    ])
    ensure_any_required_env!(%w[
      EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY
      EXPO_PUBLIC_SUPABASE_ANON_KEY
    ])

    match(
      type: "appstore",
      app_identifier: BUNDLE_ID,
      readonly: true,
      api_key: api_key
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "ios/#{SCHEME}.xcodeproj",
      team_id: "6QLNK7TXM3",
      code_sign_identity: "Apple Distribution",
      targets: [SCHEME],
      profile_name: "match AppStore #{BUNDLE_ID}",
      bundle_identifier: BUNDLE_ID
    )

    build_app(
      workspace: WORKSPACE,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      output_directory: OUTPUT_DIR,
      output_name: "#{SCHEME}.ipa",
      clean: true,
      silent: false,
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        teamID: "6QLNK7TXM3",
        provisioningProfiles: {
          BUNDLE_ID => "match AppStore #{BUNDLE_ID}"
        }
      }
    )

    # Fail before upload if the packaged native JSI ABI cannot satisfy imports.
    sh("node", File.expand_path("../../../.github/scripts/verify-ios-expo-jsi-symbols.mjs", __dir__),
       File.join(OUTPUT_DIR, "#{SCHEME}.ipa"))

    # fastlane be56dd5 currently drops --file when wrapping Xcode 26 altool.
    # Keep the Faraday 2 pin and own the upload arguments until that wrapper is fixed upstream.
    upload_ipa_with_altool!(
      File.join(OUTPUT_DIR, "#{SCHEME}.ipa"),
      wait_for_processing: true
    )
  end

  desc "Submit the latest (or specified) TestFlight build for App Store review"
  lane :submit do
    api_key = asc_api_key

    release_notes_text = ENV["IOS_RELEASE_NOTES"].to_s.strip
    release_notes_text = "Bug fixes and performance improvements." if release_notes_text.empty?
    review_notes_text = ENV["IOS_REVIEW_NOTES"].to_s.strip
    review_notes_text = DEFAULT_ATT_REVIEW_NOTES if review_notes_text.empty?

    deliver_opts = {
      api_key: api_key,
      skip_binary_upload: true,
      # Review notes are updated directly above so deliver's metadata path
      # cannot delete an existing App Review attachment.
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: true,
      force: true,
      # NO reject_if_possible: cancellation is owned solely by
      # app_store_version_slot_ready? above, which withdraws a live review ONLY
      # under the explicit IOS_STOREFRONT_CANCEL_REVIEW_FOR_RESUBMIT opt-in (after
      # verifying a replacement build exists). deliver's own reject_if_possible is
      # a second, unguarded cancellation path that fires regardless of that opt-in
      # -- it silently withdrew build 2.1.527 from App Review when 2.1.528 shipped.
      # Without it the worst case is a red build (recoverable), never a cancelled
      # Apple review.
      precheck_include_in_app_purchases: false,
      # IDFA: the storefront uses the advertiser identifier for ad-attribution
      # (Facebook/TikTok/Snapchat/Google conversion + install tracking via the
      # ad-tracking runtime), gated behind App Tracking Transparency. It does
      # NOT display ads in-app. These flags must match the Apple privacy
      # declaration or the automated review submission is rejected.
      submission_information: {
        add_id_info_uses_idfa: true,
        add_id_info_serves_ads: false,
        add_id_info_tracks_action: true,
        add_id_info_tracks_install: true,
        add_id_info_limits_tracking: true,
        export_compliance_uses_encryption: false,
        export_compliance_encryption_updated: false
      }
    }

    build_number = ENV["SUBMIT_BUILD_NUMBER"].to_s.strip
    app_version = ENV["SUBMIT_APP_VERSION"].to_s.strip

    if build_number.empty? ^ app_version.empty?
      UI.user_error!(
        "SUBMIT_BUILD_NUMBER and SUBMIT_APP_VERSION must be set together or both left empty. " \
        "Setting only one creates ambiguity about which version to attach the changelog to."
      )
    end

    deliver_opts[:build_number] = build_number unless build_number.empty?
    deliver_opts[:app_version] = app_version unless app_version.empty?

    # Free the single editable-version slot BEFORE set_changelog, which would
    # otherwise try to create a version Apple refuses to create.
    unless app_store_version_slot_ready?(app_version: app_version, build_number: build_number)
      UI.important("Skipping App Store submission; the binary is already on TestFlight.")
      next
    end

    changelog_opts = { api_key: api_key, changelog: release_notes_text }
    changelog_opts[:version] = app_version unless app_version.empty?
    set_changelog(changelog_opts)

    # set_changelog creates or renames the editable App Store version first.
    update_app_review_notes!(review_notes_text, app_version: app_version)

    deliver(deliver_opts)
  end
end
