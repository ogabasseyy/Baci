{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "stableTypeOrdering": true,
    "types": ["jest", "node", "react", "react-native"],
    "paths": {
      "@/*": ["./*"],
      "@baci/shared": ["../../packages/shared/src"],
      "@baci/shared/*": ["../../packages/shared/src/*"]
    }
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "hooks/**/*.ts",
    "hooks/**/*.tsx",
    "lib/**/*.ts",
    "services/**/*.ts",
    "stores/**/*.ts",
    "types/**/*.ts",
    "constants/**/*.ts",
    "**/*.test.ts",
    "**/*.test.tsx",
    "jest.config.ts",
    "jest.setup.ts",
    "nativewind-env.d.ts"
  ]
}
