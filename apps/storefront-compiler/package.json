{
  "name": "@baci/storefront-compiler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./benchmark": "./src/benchmark/index.ts"
  },
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --external:esbuild --external:tailwindcss --outfile=dist/cli.mjs",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "typecheck:ci": "pnpm run typecheck",
    "test": "pnpm run build && vitest run",
    "benchmark": "pnpm run build && node --import tsx src/benchmark/cli.ts"
  },
  "dependencies": {
    "@baci/experience-sdk": "workspace:*",
    "@baci/shared": "workspace:*",
    "esbuild": "^0.28.1",
    "framer-motion": "^12.40.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwindcss": "^4.3.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/node": "^24.13.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "miniflare": "4.20260722.1",
    "tsx": "4.22.4",
    "typescript": "~7.0.2",
    "vitest": "4.1.12",
    "workerd": "1.20260722.1"
  }
}
