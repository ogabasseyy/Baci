    "list_storefronts": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "stores": {
              "maxItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "storefrontId": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "slug": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 63
                  },
                  "onboardingComplete": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "storefrontId",
                  "name",
                  "slug",
                  "onboardingComplete"
                ],
                "additionalProperties": false
              }
            },
            "nextCursor": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 2048
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": ["stores", "nextCursor"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "error"
            },
            "code": {
              "type": "string",
              "enum": [
                "RATE_LIMITED",
                "INVALID_REQUEST",
                "NOT_FOUND",
                "STALE_DRAFT",
                "IDEMPOTENCY_CONFLICT",
                "CONNECTION_REVOKED",
                "INSUFFICIENT_SCOPE",
                "STORE_ALREADY_EXISTS",
                "UNSUPPORTED_TEMPLATE",
                "UNSUPPORTED_PAGE",
                "SLUG_UNAVAILABLE",
                "SLUG_IMMUTABLE",
                "PUBLISH_BLOCKED",
                "APPROVAL_REQUIRED",
                "OPERATION_FAILED"
              ]
            },
            "error": {
              "type": "string",
              "maxLength": 500
            },
            "currentVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "editorUrl": {
              "type": "string",
              "const": "https://usebaci.com/builder"
            }
          },
          "required": ["status", "code", "error"],
          "additionalProperties": false
        }
      ]
    },
