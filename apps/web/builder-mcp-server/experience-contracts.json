            },
            "code": {
              "type": "string",
              "const": "PERFORMANCE_BUDGET_EXCEEDED"
            },
            "resource": {
              "type": "string",
              "enum": [
                "javascript",
                "css",
                "ssr-html",
                "png-asset",
                "font-asset"
              ]
            },
            "error": {
              "type": "string",
              "const": "Experience request unavailable."
            }
          },
          "required": ["status", "code", "resource", "error"],
          "additionalProperties": false
        },
        {
          "type": "object",
