{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "ok"
        },
        "value": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      },
      "required": ["status", "value"],
      "additionalProperties": false
    },
    {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "error"
            },
            "code": {
              "type": "string",
              "enum": [
                "INVALID_REQUEST",
                "NOT_FOUND",
                "INSUFFICIENT_SCOPE",
                "CONNECTION_REVOKED",
                "RATE_LIMITED",
                "UNAVAILABLE",
                "STALE_VERSION",
                "STALE_SOURCE",
                "APPROVAL_EXPIRED",
                "APPROVAL_MISMATCH",
                "PREVIEW_REQUIRED",
                "INCOMPATIBLE_POLICY",
                "OUTPUT_NOT_RETAINED",
                "ASSET_NOT_RETAINED",
                "ROLLBACK_NOT_RETAINED",
                "COMPATIBLE_LEGACY_REQUIRED",
                "IDEMPOTENCY_CONFLICT",
                "BUILD_FAILED",
                "QUOTA_EXCEEDED"
              ]
            },
            "error": {
              "type": "string",
              "const": "Experience request unavailable."
            }
          },
          "required": ["status", "code", "error"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
