            },
            "code": {
              "type": "string",
              "const": "PERFORMANCE_NOT_QUALIFIED"
            },
            "reason": {
              "type": "string",
              "enum": [
                "invalid-report",
                "binding-mismatch",
                "data-binding-mismatch",
                "renderer-mismatch",
                "contaminated",
                "route-matrix-mismatch",
                "missing-metrics",
                "content-not-ready",
                "lcp-threshold",
                "cls-threshold"
              ]
            },
            "error": {
              "type": "string",
              "const": "Experience request unavailable."
            }
          },
          "required": ["status", "code", "reason", "error"],
          "additionalProperties": false
        }
