{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "next.config.{js,ts,cjs,mjs}",
    "src/proxy.ts",
    "src/app/**/{page,layout,loading,error,not-found,global-error,route,template,default}.{ts,tsx}",
    "scripts/*.{js,ts,cjs,mjs}"
  ],
  "project": ["src/**/*.{ts,tsx,js,jsx}", "scripts/*.{js,ts,cjs,mjs}"],
  "ignore": [
    "**/*.d.ts",
    "src/components/ui/**",
    "src/lib/mycover.ts",
    "src/lib/namecheap.ts",
    "src/lib/normalize-product.ts",
    "src/lib/offline-conversions.ts",
    "src/lib/paystack.ts",
    "src/lib/placeholder-images.ts",
    "src/lib/products-server.ts",
    "src/lib/products.ts",
    "src/lib/routes.ts",
    "src/lib/seo-utils.ts",
    "src/lib/server-side-analytics.ts",
    "src/lib/shipping/**/*.ts",
    "src/lib/snapchat-capi.ts",
    "src/lib/tiktok-events-api.ts",
    "src/lib/vercel.ts",
    "src/lib/zeptomail.ts",
    "src/templates/registry.tsx",
    "src/types/**/*.ts",
    "src/ai/provider.ts"
  ],
  "ignoreDependencies": [
    "postcss",
    "autoprefixer",
    "tailwindcss",
    "sharp",
    "encoding",
    "@ai-sdk/google",
    "@google/generative-ai",
    "@ai-sdk/rsc",
    "@radix-ui/*",
    "@supabase/*",
    "@tiptap/*",
    "ai",
    "class-variance-authority",
    "clsx",
    "cmdk",
    "colord",
    "colorthief",
    "date-fns",
    "dotenv",
    "embla-carousel-autoplay",
    "embla-carousel-react",
    "framer-motion",
    "fuse.js",
    "iconoir-react",
    "isomorphic-dompurify",
    "jimp",
    "jspdf",
    "jspdf-autotable",
    "lucide-react",
    "marked",
    "next-themes",
    "react-datepicker",
    "react-dropzone",
    "react-grid-layout",
    "react-hook-form",
    "react-lite-youtube-embed",
    "react-phone-number-input",
    "recharts",
    "sanitize-html",
    "tailwind-merge",
    "web-vitals",
    "whois-json",
    "zeptomail",
    "zod",
    "nanoid",
    "zustand"
  ]
}
