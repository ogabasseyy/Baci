{
  "name": "@baci/web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "BACI_STOREFRONT_BUILD_READS=bounded NODE_ENV=production next build",
    "build:ci": "BACI_STOREFRONT_BUILD_READS=offline NODE_ENV=production next build --experimental-build-mode=compile",
    "start": "next start",
    "lint": "biome check .",
    "format": "biome format --write .",
    "analyze": "next experimental-analyze --output",
    "docs": "node --experimental-loader=./tools/typedoc-typescript6.mjs ../../node_modules/typedoc/bin/typedoc",
    "typecheck": "tsc --noEmit && pnpm typecheck:tools-workers",
    "typecheck:tools-workers": "tsc --noEmit -p tsconfig.tools-workers.json",
    "test": "vitest run",
    "test:ci": "pnpm test && pnpm verify:quiz-assets",
    "verify:quiz-assets": "tsx src/scripts/verify-quiz-assets-cli.ts",
    "check:quiz-approval": "tsx src/scripts/check-quiz-production-approval.ts",
    "verify:blog-seo": "tsx src/scripts/verify-ogabassey-blog-seo.ts",
    "knip": "knip --no-exit-code",
    "seo:pagespeed": "tsx tools/seo/run-pagespeed.cli.ts",
    "seo:readiness": "tsx tools/seo/run-search-console-readiness.cli.ts",
    "perf:ogabassey-critical-path": "node tools/perf/measure-ogabassey-critical-path.mjs",
    "perf:ogabassey-cache-probe": "node tools/perf/measure-ogabassey-cache-hit-rate.mjs",
    "perf:ogabassey-css-budget": "node tools/perf/assert-ogabassey-css-budget.mjs",
    "perf:ogabassey-pdp-lcp": "node tools/perf/measure-ogabassey-pdp-lcp.mjs",
    "cost:storefront-origin-budget": "tsx tools/cost/storefront-origin-budget.ts",
    "db:replay:capture-ledger": "tsx tools/db/capture-supabase-history-ledger.ts",
    "db:replay:capture-production-effect": "tsx tools/db/capture-production-effect-provenance-cli.ts",
    "db:replay:attest-post-replay": "tsx tools/db/attest-post-replay-production.ts",
    "db:replay:chronological": "tsx tools/db/run-supabase-history-replay.ts --mode chronological --pending-repair-state materialized --comparison-mode enforce",
    "db:replay:production-effect": "tsx tools/db/run-supabase-history-replay.ts --mode production-effect --pending-repair-state materialized --comparison-mode enforce",
    "capture-screenshots": "node scripts/capture-template-screenshots.mjs",
    "backfill:image-format-cache": "tsx src/scripts/backfill-image-format-cache.ts",
    "process:import-jobs": "tsx src/scripts/process-import-jobs.ts",
    "process:domain-events": "tsx src/scripts/process-domain-events.ts",
    "process:event-deliveries": "tsx src/scripts/process-event-deliveries.ts",
    "reconcile:paystack-dva": "NODE_OPTIONS=--conditions=react-server tsx src/scripts/reconcile-paystack-dva.ts",
    "reconcile:paystack:unmatched-partial": "NODE_OPTIONS=--conditions=react-server tsx src/scripts/reconcile-paystack-unmatched-partial.ts",
    "sync:jumia-orders": "tsx src/scripts/sync-jumia-orders.ts",
    "mcp": "tsx mcp-server/server.ts"
  },
