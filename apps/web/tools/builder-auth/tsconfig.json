{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ES2023", "DOM"],
    "allowJs": true,
    "checkJs": false
  },
  "include": ["./*.ts"],
  "exclude": ["publication*.ts", "verify-publication.ts", "local-postgres*.ts"]
}
