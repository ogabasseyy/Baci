    },
    "editRunner": {
      "source": "tools/builder-auth/edit-runner.ts",
      "ready": false,
      "blocker": "Staging URL and separate bounded scheduler bootstrap required"
    },
    "verifier": {
      "source": "tools/builder-auth/verify-publication.ts",
      "ready": false,
      "blocker": "Dedicated evidence credential and owner-session delivery/bootstrap required"
    }
