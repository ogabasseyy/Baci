FROM node:24-bookworm-slim

WORKDIR /workspace
# Run pnpm --filter @baci/web build:connector-gateway first. The bundle includes
# gateway dependencies; the runtime does not install the whole commerce monorepo.
COPY --chown=node:node apps/web/tools/connector-gateway/dist/server.js ./server.js
ARG CONNECTOR_SOURCE_SHA
LABEL org.opencontainers.image.revision=$CONNECTOR_SOURCE_SHA
ENV NODE_ENV=production
USER node

EXPOSE 3201
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3201/health').then(async r => { const j = await r.json(); if (!r.ok || j.db !== 'up') process.exit(1); }).catch(() => process.exit(1))"

CMD ["node", "server.js"]
