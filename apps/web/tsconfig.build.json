{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "checkers": 1,
    "tsBuildInfoFile": ".next/cache/tsconfig.build.tsbuildinfo"
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/typecheck/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".typed-navigation/link.d.ts"
  ],
  "exclude": [
    "node_modules",
    ".next/types/link.d.ts",
    "supabase",
    "supabase/**/*",
    "scripts",
    "src/scripts",
    ".next/dev",
    ".next/dev/**/*",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/__tests__/**",
    "**/__mocks__/**"
  ]
}
