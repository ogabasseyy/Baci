{
  "$schema": "https://biomejs.dev/schemas/2.3.10/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "includes": [
      "**",
      "!**/.next",
      "!**/node_modules",
      "!**/.wrangler",
      "!**/.qualification-dist",
      "!**/scripts",
      "!**/scripts-tmp",
      "!**/.gemini",
      "!**/reproduce_issue.ts",
      "!**/src/app/page.backup.tsx",
      "!**/src/app/page.tsx.bak",
      "!**/src/app/globals.css",
      "!**/src/app/(storefront)/storefront-globals.css",
      "!apps/mobile-storefront/global.css",
      "!**/src/components/storefront/new-template",
      "!**/src/components/storefront/ogabassey/**/*.*",
      "apps/web/src/components/storefront/ogabassey/pages/checkout-page*.test.tsx",
      "apps/web/src/components/storefront/ogabassey/pages/checkout-page*test-support.tsx",
      "apps/web/src/components/storefront/ogabassey/pages/checkout-page.test-fixtures.tsx",
      "apps/web/src/components/storefront/ogabassey/pages/checkout/load-resumed-checkout-order.ts",
      "apps/web/src/components/storefront/ogabassey/pages/checkout/build-checkout-order-request*",
      "apps/web/src/components/storefront/ogabassey/pages/checkout/hooks/use-load-resumed-order*",
      "apps/web/src/components/storefront/ogabassey/pages/checkout/hooks/use-order-totals*",
      "apps/web/src/components/storefront/ogabassey/pages/checkout/components/PaymentStep.tsx",
      "apps/web/src/components/storefront/ogabassey/pages/checkout/components/PaymentStepAccessibility.test.tsx",
      "apps/web/src/components/storefront/ogabassey/pages/checkout/components/CheckoutAccountFields.test.tsx",
      "apps/web/src/components/storefront/ogabassey/pages/checkout/components/CheckoutAccountFields.tsx",
      "apps/web/src/components/storefront/ogabassey/pages/checkout/components/CheckoutStepSection.tsx",
      "apps/web/src/components/storefront/ogabassey/pages/checkout/components/CheckoutStepSection.test.tsx",
      "apps/web/src/components/storefront/ogabassey/pages/checkout/components/ContactFields.tsx",
      "apps/web/src/components/storefront/ogabassey/pages/checkout/components/{ContactFields,DeliveryAddressFields,DeliveryMethodTabs,DeliveryOptions,StationPickupOptions}.test.tsx",
      "apps/web/src/components/storefront/ogabassey/pages/checkout/load-resumed-checkout-order.test.ts",
      "apps/web/src/components/storefront/ogabassey/pages/checkout/components/ContactStep.test.tsx",
      "apps/web/src/components/storefront/ogabassey/pages/checkout/components/ContactStep.tsx",
      "apps/web/src/components/storefront/ogabassey/pages/checkout/components/DeliveryAddressFields.tsx",
      "apps/web/src/components/storefront/ogabassey/pages/checkout/components/DeliveryMethodTabs.tsx",
      "apps/web/src/components/storefront/ogabassey/pages/checkout/components/DeliveryOptions.tsx",
      "apps/web/src/components/storefront/ogabassey/pages/checkout/components/StationPickupOptions.tsx",
      "apps/web/src/components/storefront/ogabassey/pages/checkout/components/contact.test-support.tsx",
      "apps/web/src/components/storefront/ogabassey/pages/checkout/contact-validation.test.ts",
      "apps/web/src/components/storefront/ogabassey/pages/checkout/contact-validation.ts",
      "apps/web/src/components/storefront/ogabassey/pages/checkout/handlers/recover-pending-checkout-order*.ts",
      "apps/web/src/components/storefront/ogabassey/pages/checkout/handlers/submit-checkout-order.ts",
      "apps/web/src/components/storefront/ogabassey/pages/checkout/handlers/submit-checkout-order.test.ts",
      "apps/web/src/components/storefront/ogabassey/pages/checkout/handlers/initialize-checkout-dva.ts",
      "apps/web/src/components/storefront/ogabassey/pages/checkout/handlers/initialize-checkout-dva.test.ts",
      "apps/web/src/components/storefront/ogabassey/pages/checkout/handlers/initialize-checkout-gateway.ts",
      "apps/web/src/components/storefront/ogabassey/pages/checkout/handlers/initialize-checkout-gateway.test.ts",
      "apps/web/src/components/storefront/ogabassey/pages/checkout/handlers/open-checkout-credpal.ts",
      "apps/web/src/components/storefront/ogabassey/pages/checkout/handlers/open-checkout-credpal.test.ts",
      "apps/web/src/components/storefront/ogabassey/pages/checkout/handlers/open-checkout-credit-direct.ts",
      "apps/web/src/components/storefront/ogabassey/pages/checkout/handlers/open-checkout-credit-direct.test.ts",
      "apps/web/src/components/storefront/ogabassey/pages/checkout/handlers/complete-checkout-order.ts",
      "apps/web/src/components/storefront/ogabassey/pages/checkout/handlers/complete-checkout-order.test.ts",
      "!**/src/components/storefront/ogabassey-v2",
      "!**/src/components/storefront/lumina",
      "!**/src/app/template-preview",
      "!**/src/app/preview",
      "!**/src/templates",
      "!**/mcp-server",
      "!process_*.cjs",
      "!**/public",
      "!**/.wrangler"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80,
    "lineEnding": "lf"
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": {
        "recommended": true,
        "noAccessKey": "error",
        "noAriaHiddenOnFocusable": "error",
        "noAriaUnsupportedElements": "error",
        "noAutofocus": "warn",
        "noDistractingElements": "error",
        "noHeaderScope": "error",
        "noInteractiveElementToNoninteractiveRole": "warn",
        "noNoninteractiveElementToInteractiveRole": "warn",
        "noNoninteractiveTabindex": "warn",
        "noPositiveTabindex": "error",
        "noRedundantAlt": "error",
        "noRedundantRoles": "error",
        "noSvgWithoutTitle": "warn",
        "useAltText": "error",
        "useAnchorContent": "error",
        "useAriaActivedescendantWithTabindex": "error",
        "useAriaPropsForRole": "error",
        "useButtonType": "error",
        "useHeadingContent": "error",
        "useHtmlLang": "error",
        "useIframeTitle": "error",
        "useKeyWithClickEvents": "warn",
        "useKeyWithMouseEvents": "warn",
        "useMediaCaption": "warn",
        "useValidAnchor": "error",
        "useValidAriaProps": "error",
        "useValidAriaRole": "error",
        "useValidAriaValues": "error",
        "useValidLang": "error"
      },
      "complexity": {
        "recommended": true,
        "noExtraBooleanCast": "error",
        "noUselessCatch": "error",
        "noUselessConstructor": "error",
        "noUselessEmptyExport": "error",
        "noUselessFragments": "error",
        "noUselessLabel": "error",
        "noUselessLoneBlockStatements": "error",
        "noUselessRename": "error",
        "noUselessSwitchCase": "error",
        "noUselessTernary": "error",
        "noUselessThisAlias": "error",
        "useFlatMap": "error",
        "useLiteralKeys": "error",
        "useOptionalChain": "error",
        "useRegexLiterals": "error",
        "noAdjacentSpacesInRegex": "error",
        "noArguments": "error",
        "noCommaOperator": "error",
        "useNumericLiterals": "error"
      },
      "correctness": {
        "recommended": true,
        "noChildrenProp": "error",
        "noConstAssign": "error",
        "noConstantCondition": "error",
        "noEmptyCharacterClassInRegex": "error",
        "noEmptyPattern": "error",
        "noGlobalObjectCalls": "error",
        "noInnerDeclarations": "error",
        "noInvalidConstructorSuper": "error",
        "noNonoctalDecimalEscape": "error",
        "noPrecisionLoss": "error",
        "noSelfAssign": "error",
        "noSetterReturn": "error",
        "noSwitchDeclarations": "error",
        "noUndeclaredVariables": "error",
        "noUnreachable": "error",
        "noUnreachableSuper": "error",
        "noUnsafeFinally": "error",
        "noUnsafeOptionalChaining": "error",
        "noUnusedLabels": "error",
        "noUnusedPrivateClassMembers": "error",
        "noUnusedVariables": "error",
        "useExhaustiveDependencies": "warn",
        "useHookAtTopLevel": "error",
        "useIsNan": "error",
        "useValidForDirection": "error",
        "useYield": "error",
        "noInvalidBuiltinInstantiation": "error",
        "useValidTypeof": "error"
      },
      "security": {
        "recommended": true,
        "noDangerouslySetInnerHtml": "warn",
        "noDangerouslySetInnerHtmlWithChildren": "error",
        "noBlankTarget": "error"
      },
      "style": {
        "recommended": true,
        "noDefaultExport": "off",
        "noImplicitBoolean": "off",
        "noNegationElse": "off",
        "noParameterAssign": "warn",
        "noRestrictedGlobals": "error",
        "useBlockStatements": "off",
        "useCollapsedElseIf": "error",
        "useConst": "error",
        "useDefaultParameterLast": "error",
        "useExponentiationOperator": "error",
        "useFragmentSyntax": "error",
        "useNodejsImportProtocol": "error",
        "useNumberNamespace": "error",
        "useSelfClosingElements": "error",
        "useShorthandAssign": "error",
        "useSingleVarDeclarator": "error",
        "useTemplate": "error",
        "useArrayLiterals": "error",
        "useConsistentArrayType": {
          "level": "error",
          "options": {
            "syntax": "shorthand"
          }
        }
      },
      "suspicious": {
        "recommended": true,
        "noArrayIndexKey": "warn",
        "noAssignInExpressions": "error",
        "noAsyncPromiseExecutor": "error",
        "noCatchAssign": "error",
        "noClassAssign": "error",
        "noCommentText": "error",
        "noCompareNegZero": "error",
        "noConfusingLabels": "error",
        "noControlCharactersInRegex": "error",
        "noDebugger": "warn",
        "noDoubleEquals": "error",
        "noDuplicateCase": "error",
        "noDuplicateClassMembers": "error",
        "noDuplicateJsxProps": "error",
        "noDuplicateObjectKeys": "error",
        "noDuplicateParameters": "error",
        "noEmptyBlockStatements": "error",
        "noExplicitAny": "warn",
        "noExtraNonNullAssertion": "error",
        "noFallthroughSwitchClause": "error",
        "noFunctionAssign": "error",
        "noGlobalAssign": "error",
        "noImportAssign": "error",
        "noLabelVar": "error",
        "noMisleadingCharacterClass": "error",
        "noMisleadingInstantiator": "error",
        "noPrototypeBuiltins": "error",
        "noRedeclare": "error",
        "noSelfCompare": "error",
        "noShadowRestrictedNames": "error",
        "noSparseArray": "error",
        "noUnsafeDeclarationMerging": "error",
        "noUnsafeNegation": "error",
        "useAwait": "error",
        "useDefaultSwitchClauseLast": "error",
        "useGetterReturn": "error",
        "useNamespaceKeyword": "error",
        "noWith": "error",
        "noVar": "error",
        "noConsole": {
          "level": "off",
          "options": {
            "allow": ["log"]
          }
        }
      }
    }
  },
  "javascript": {
    "globals": ["Deno", "ColorThief", "__DEV__", "jest"],
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "trailingCommas": "es5",
      "semicolons": "always",
      "arrowParentheses": "always",
      "bracketSpacing": true,
      "bracketSameLine": false,
      "quoteProperties": "asNeeded",
      "attributePosition": "auto"
    }
  },
  "overrides": [
    {
      "includes": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.test.js",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/*.spec.js",
        "**/__tests__/**",
        "**/__mocks__/**",
        "**/jest.setup.ts"
      ],
      "javascript": {
        "globals": ["vi", "jest", "__DEV__"]
      },
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off",
            "noEmptyBlockStatements": "off",
            "useAwait": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/components/storefront/new-template/**",
        "src/components/storefront/ogabassey/**",
        "src/components/storefront/ogabassey-v2/**",
        "src/components/storefront/lumina/**",
        "src/app/(preview)/**",
        "src/app/preview/**",
        "src/app/template-preview/**",
        "src/templates/**"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "useButtonType": "warn",
            "useKeyWithClickEvents": "warn",
            "noStaticElementInteractions": "warn",
            "noLabelWithoutControl": "warn"
          },
          "performance": {
            "noImgElement": "warn"
          },
          "suspicious": {
            "noArrayIndexKey": "warn",
            "noExplicitAny": "warn"
          },
          "style": {
            "noNonNullAssertion": "warn"
          }
        }
      }
    },
    {
      "includes": [
        "**/pages/about/page.tsx",
        "**/pages/contact/page.tsx",
        "**/pages/faq/page.tsx",
        "**/pages/privacy/page.tsx",
        "**/pages/terms/page.tsx"
      ],
      "linter": {
        "rules": {
          "security": {
            "noDangerouslySetInnerHtml": "off"
          }
        }
      }
    }
  ]
}
