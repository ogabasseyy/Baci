diff --git a/scripts/backfill_merchant_blog_classifications.py b/scripts/backfill_merchant_blog_classifications.py
new file mode 100644
index 0000000000..f0ad436487
--- /dev/null
+++ b/scripts/backfill_merchant_blog_classifications.py
@@ -0,0 +1,105 @@
+"""Dry-run-first validation/apply of authenticated merchant article classifications."""
+from __future__ import annotations
+
+import argparse
+import json
+import os
+from pathlib import Path
+from typing import Any
+
+from codex_content_agent.merchant_blog_classification import (
+    _load_approved_receipt_artifacts,
+    _receipt_digest_matches,
+    classification_credentials,
+    fetch_classification_context,
+    propose_receipt_classification,
+    set_classification,
+)
+
+
+def run(run_root: Path, *, merchant_id: str, apply: bool = False, limit: int = 200) -> dict[str, Any]:
+    credentials = classification_credentials()
+    if credentials is None:
+        return {"status": "unavailable", "reason": "auth_not_configured", "receipt_count": 0,
+                "applied_count": 0, "rejected_count": 0, "unavailable_count": 1,
+                "proposals": []}
+    receipt_paths = sorted(run_root.glob("*/release-receipt.json"))[:max(0, min(limit, 500))]
+    proposals: list[dict[str, Any]] = []
+    for path in receipt_paths:
+        try:
+            proposal = propose_receipt_classification(path, merchant_id=merchant_id)
+        except Exception as error:
+            proposals.append({"receipt_path": str(path), "status": "rejected",
+                              "reason": type(error).__name__})
+            continue
+        if proposal.get("status") != "proposed":
+            proposals.append({"receipt_path": str(path), **proposal})
+            continue
+        proposal["receipt_path"] = str(path)
+        try:
+            rows = fetch_classification_context(credentials, merchant_id, [proposal["post_id"]])
+            context = next((row for row in rows if row.get("post_id") == proposal["post_id"]), None)
+            from codex_content_agent.release_policy import _draft_matches_current_post
+            _receipt, artifacts, receipt_error = _load_approved_receipt_artifacts(
+                path, proposal=proposal, merchant_id=merchant_id
+            )
+            if not context or not context.get("input_fingerprint"):
+                proposal.update(status="unavailable", reason="context_missing")
+            elif receipt_error:
+                proposal.update(status="rejected", reason=receipt_error)
+            elif not artifacts or not _draft_matches_current_post(
+                artifacts.get("draft", {}),
+                {"slug": context.get("slug"), "title": context.get("title"),
+                 "category": context.get("category"), "content": context.get("content")},
+            ):
+                proposal.update(status="rejected", reason="current_post_mismatch")
+            elif apply:
+                if not _receipt_digest_matches(path, str(proposal.get("evidence_sha256") or "")):
+                    proposal.update(status="rejected", reason="receipt_changed")
+                    proposals.append(proposal)
+                    continue
+                result = set_classification(
+                    credentials, merchant_id=merchant_id, post_id=proposal["post_id"],
+                    intent=proposal["intent"], fingerprint=context["input_fingerprint"],
+                    evidence_sha256=proposal["evidence_sha256"],
+                )
+                from codex_content_agent.blog_revalidation import revalidate_blog_cache
+                revalidation = revalidate_blog_cache([str(context.get("slug") or "")])
+                proposal.update(status="applied", result=result, revalidation=revalidation)
+        except Exception as error:
+            proposal.update(status="unavailable", reason=type(error).__name__)
+        proposals.append(proposal)
+    applied_count = sum(item.get("status") == "applied" for item in proposals)
+    rejected_count = sum(item.get("status") == "rejected" for item in proposals)
+    unavailable_count = sum(item.get("status") == "unavailable" for item in proposals)
+    if not apply:
+        status = "dry_run"
+    elif rejected_count or unavailable_count:
+        status = "partial" if applied_count else "failed"
+    else:
+        status = "applied" if applied_count else "no_candidates"
+    return {"status": status, "merchant_id": merchant_id, "receipt_count": len(receipt_paths),
+            "applied_count": applied_count, "rejected_count": rejected_count,
+            "unavailable_count": unavailable_count, "proposals": proposals}
+
+
+def main() -> int:
+    from dotenv import load_dotenv
+
+    root = Path(__file__).resolve().parents[1]
+    load_dotenv(root / ".env")
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--run-root", type=Path, default=root / "runs")
+    parser.add_argument("--merchant-id", default=os.environ.get("OGABASSEY_MERCHANT_ID", ""))
+    parser.add_argument("--limit", type=int, default=200)
+    parser.add_argument("--apply", action="store_true", help="write through the authenticated classification RPC")
+    args = parser.parse_args()
+    if not args.merchant_id:
+        parser.error("--merchant-id or OGABASSEY_MERCHANT_ID is required")
+    report = run(args.run_root, merchant_id=args.merchant_id, apply=args.apply, limit=args.limit)
+    print(json.dumps(report, indent=2))
+    return 1 if args.apply and report.get("status") in {"unavailable", "partial", "failed"} else 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
