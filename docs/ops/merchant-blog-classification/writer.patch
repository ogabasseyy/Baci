diff --git a/codex_content_agent/merchant_blog_classification.py b/codex_content_agent/merchant_blog_classification.py
new file mode 100644
index 0000000000..0d628cc79a
--- /dev/null
+++ b/codex_content_agent/merchant_blog_classification.py
@@ -0,0 +1,300 @@
+"""Separate merchant blog taxonomy, written only through authenticated RPCs."""
+from __future__ import annotations
+
+import base64
+import hashlib
+import json
+import os
+import urllib.parse
+import urllib.error
+import urllib.request
+from pathlib import Path
+from typing import Any, Mapping
+
+CLASSIFIER_VERSION = "receipt-task-v1"
+TASK_INTENTS = {
+    "news": "news",
+    "comparison": "comparison",
+    "repair_support": "repair-guide",
+    "product_support": "buying-guide",
+}
+ALLOWED_INTENTS = frozenset({"news", "comparison", "repair-guide", "buying-guide"})
+ALLOWED_SOURCES = frozenset({"merchant_declared", "verified_receipt", "reviewed"})
+
+
+def intent_for_task(task_type: str) -> str | None:
+    return TASK_INTENTS.get(str(task_type or "").strip())
+
+
+def _decode_jwt_role(token: str) -> str | None:
+    try:
+        payload = token.split(".")[1]
+        payload += "=" * (-len(payload) % 4)
+        value = json.loads(base64.urlsafe_b64decode(payload.encode("ascii")))
+    except (IndexError, ValueError, TypeError, json.JSONDecodeError):
+        return None
+    return value.get("role") if isinstance(value, dict) else None
+
+
+def classification_credentials(
+    *, env: Mapping[str, str] | None = None, token_file: str | Path | None = None
+) -> dict[str, str] | None:
+    values = os.environ if env is None else env
+    url = str(values.get("SUPABASE_URL") or "").strip().rstrip("/")
+    key = str(values.get("SUPABASE_ANON_KEY") or values.get("SUPABASE_PUBLISHABLE_KEY") or "").strip()
+    token_path = token_file or values.get("MERCHANT_CLASSIFICATION_ACCESS_TOKEN_FILE")
+    try:
+        parsed_url = urllib.parse.urlsplit(url)
+    except ValueError:
+        return None
+    if (parsed_url.scheme != "https" or not parsed_url.hostname or parsed_url.username
+            or parsed_url.password or parsed_url.query or parsed_url.fragment):
+        return None
+    if (not url or not key or not token_path or key.startswith("sb_secret_")
+            or _decode_jwt_role(key) in {"service_role", "supabase_admin"}):
+        return None
+    try:
+        token = Path(token_path).read_text(encoding="utf-8").strip()
+    except OSError:
+        return None
+    if not token or _decode_jwt_role(token) != "authenticated":
+        return None
+    return {"url": url, "key": key, "token": token}
+
+
+def effective_classification(
+    row: dict[str, Any], classification: dict[str, Any] | None
+) -> dict[str, Any]:
+    result = dict(row)
+    current = classification if isinstance(classification, dict) else {}
+    classification_fields = ("intent", "source", "taxonomy_version", "classifier_version", "classified_at")
+    has_classification = any(current.get(field) is not None for field in classification_fields)
+    state = "missing"
+    if current.get("stale_at") is not None:
+        state = "stale"
+    elif current and has_classification:
+        state = "invalid"
+    valid = (
+        bool(current)
+        and has_classification
+        and current.get("stale_at") is None
+        and current.get("post_id") == row.get("id")
+        and current.get("stale_at") is None
+        and current.get("intent") in ALLOWED_INTENTS
+        and current.get("source") in ALLOWED_SOURCES
+        and current.get("taxonomy_version") == 1
+        and bool(str(current.get("classifier_version") or "").strip())
+    )
+    if valid:
+        revision = current.get("post_revision")
+        inventory_revision = row.get("classification_revision")
+        if not isinstance(revision, str) or not revision or not isinstance(inventory_revision, str) or not inventory_revision:
+            valid, state = False, "revision_unknown"
+        elif revision != inventory_revision:
+            valid, state = False, "stale_revision"
+        else:
+            state = "current"
+    result.update(
+        {
+            "effective_intent": current.get("intent") if valid else None,
+            "effective_intent_source": current.get("source") if valid else None,
+            "effective_intent_version": current.get("taxonomy_version") if valid else None,
+            "effective_intent_classifier_version": current.get("classifier_version") if valid else None,
+            "effective_intent_classified_at": current.get("classified_at") if valid else None,
+            "effective_intent_status": state,
+        }
+    )
+    return result
+
+
+def overlay_inventory(rows: list[dict[str, Any]], *, merchant_id: str) -> tuple[list[dict[str, Any]], dict[str, Any]]:
+    credentials = classification_credentials()
+    if credentials is None:
+        return [effective_classification(row, None) for row in rows], {
+            "status": "unavailable", "reason": "auth_not_configured", "classified_rows": 0,
+        }
+    try:
+        by_id: dict[str, dict[str, Any]] = {}
+        ids = [str(row.get("id") or "") for row in rows if row.get("id")]
+        for start in range(0, len(ids), 200):
+            for item in fetch_inventory_snapshot(credentials, merchant_id, ids[start:start + 200]):
+                if isinstance(item, dict) and item.get("post_id"):
+                    by_id[str(item["post_id"])] = item
+        result = [effective_classification(row, by_id.get(str(row.get("id") or ""))) for row in rows]
+        counts: dict[str, int] = {}
+        for item in result:
+            state = str(item.get("effective_intent_status") or "missing")
+            counts[state] = counts.get(state, 0) + 1
+        return result, {"status": "available", "classified_rows": sum(bool(item.get("effective_intent")) for item in result),
+                        "coverage_by_status": counts}
+    except (OSError, ValueError, RuntimeError, urllib.error.URLError, urllib.error.HTTPError) as error:
+        return [effective_classification(row, None) for row in rows], {
+            "status": "unavailable", "reason": type(error).__name__, "classified_rows": 0,
+        }
+
+
+def _rpc(credentials: dict[str, str], name: str, payload: dict[str, Any]) -> Any:
+    request = urllib.request.Request(
+        f"{credentials['url']}/rest/v1/rpc/{name}",
+        data=json.dumps(payload).encode("utf-8"),
+        headers={
+            "apikey": credentials["key"],
+            "Authorization": f"Bearer {credentials['token']}",
+            "Content-Type": "application/json",
+        },
+        method="POST",
+    )
+    opener = urllib.request.build_opener(_NoRedirectHandler)
+    with opener.open(request, timeout=20) as response:
+        return json.loads(response.read().decode("utf-8"))
+
+
+class _NoRedirectHandler(urllib.request.HTTPRedirectHandler):
+    def redirect_request(self, req: Any, fp: Any, code: int, msg: str,
+                         headers: Any, newurl: str) -> None:
+        return None
+
+
+def fetch_classification_context(
+    credentials: dict[str, str], merchant_id: str, post_ids: list[str]
+) -> list[dict[str, Any]]:
+    if not post_ids or len(post_ids) > 20:
+        raise ValueError("classification context requests must contain 1 to 20 post IDs")
+    result = _rpc(credentials, "get_merchant_blog_classification_context_v1", {
+        "p_merchant_id": merchant_id, "p_post_ids": post_ids,
+    })
+    if not isinstance(result, list):
+        raise ValueError("classification context returned invalid rows")
+    return result
+
+
+def fetch_inventory_snapshot(
+    credentials: dict[str, str], merchant_id: str, post_ids: list[str]
+) -> list[dict[str, Any]]:
+    if not post_ids or len(post_ids) > 200:
+        raise ValueError("inventory classification requests must contain 1 to 200 post IDs")
+    result = _rpc(credentials, "get_merchant_blog_classification_snapshot_v1", {
+        "p_merchant_id": merchant_id, "p_post_ids": post_ids,
+    })
+    if not isinstance(result, list):
+        raise ValueError("classification snapshot returned invalid rows")
+    return result
+
+
+def set_classification(
+    credentials: dict[str, str], *, merchant_id: str, post_id: str, intent: str,
+    fingerprint: str, evidence_sha256: str, source: str = "verified_receipt",
+) -> dict[str, Any]:
+    result = _rpc(credentials, "set_merchant_blog_classification_v1", {
+        "p_merchant_id": merchant_id, "p_post_id": post_id, "p_intent": intent,
+        "p_expected_fingerprint": fingerprint, "p_classifier_version": CLASSIFIER_VERSION,
+        "p_evidence_sha256": evidence_sha256, "p_source": source,
+    })
+    if not isinstance(result, dict):
+        raise ValueError("classification write returned invalid result")
+    if (result.get("status") != "current" or result.get("post_id") != post_id
+            or result.get("intent") != intent):
+        raise ValueError("classification write did not confirm the requested current result")
+    return result
+
+
+def propose_receipt_classification(receipt_path: Path, *, merchant_id: str) -> dict[str, Any]:
+    """Validate receipt and release artifacts; never treats receipt fields as authority alone."""
+    from codex_content_agent.editorial_release_controller import _load_artifacts
+    from codex_content_agent.release_policy import _receipt_matches_draft_contract
+    from codex_content_agent.release_receipt import load_valid_release_receipt
+
+    receipt = load_valid_release_receipt(receipt_path)
+    if receipt.get("merchant_id") != merchant_id:
+        return {"status": "rejected", "reason": "wrong_merchant"}
+    artifacts = _load_artifacts(receipt_path, receipt)
+    if not artifacts.get("valid"):
+        return {"status": "rejected", "reason": "artifact_integrity_failed"}
+    draft = artifacts.get("draft")
+    if not isinstance(draft, dict) or str(receipt_path.parent.name) != str(receipt.get("run_id")):
+        return {"status": "rejected", "reason": "post_contract_mismatch"}
+    task_type = str(draft.get("task_type") or "")
+    intent = intent_for_task(task_type)
+    if intent is None:
+        return {"status": "rejected", "reason": "unsupported_task"}
+    if task_type != receipt.get("task_type") or not _receipt_matches_draft_contract(receipt, draft, task_type):
+        return {"status": "rejected", "reason": "post_contract_mismatch"}
+    evidence = hashlib.sha256(receipt_path.read_bytes()).hexdigest()
+    return {
+        "status": "proposed", "post_id": receipt["post_id"], "merchant_id": merchant_id,
+        "intent": intent, "evidence_sha256": evidence, "receipt_path": str(receipt_path),
+    }
+
+
+def _receipt_digest_matches(receipt_path: Path, expected_sha256: str) -> bool:
+    try:
+        return hashlib.sha256(receipt_path.read_bytes()).hexdigest() == expected_sha256
+    except OSError:
+        return False
+
+
+def _load_approved_receipt_artifacts(
+    receipt_path: Path, *, proposal: dict[str, Any], merchant_id: str
+) -> tuple[dict[str, Any] | None, dict[str, Any] | None, str | None]:
+    """Reconfirm the exact receipt approved before network context was fetched."""
+    from codex_content_agent.editorial_release_controller import _load_artifacts
+    from codex_content_agent.release_receipt import load_valid_release_receipt
+
+    expected_sha256 = str(proposal.get("evidence_sha256") or "")
+    if not expected_sha256 or not _receipt_digest_matches(receipt_path, expected_sha256):
+        return None, None, "receipt_changed"
+    try:
+        receipt = load_valid_release_receipt(receipt_path)
+    except (OSError, ValueError):
+        return None, None, "receipt_changed"
+    if not _receipt_digest_matches(receipt_path, expected_sha256):
+        return None, None, "receipt_changed"
+    if (receipt.get("merchant_id") != merchant_id
+            or receipt.get("post_id") != proposal.get("post_id")
+            or intent_for_task(str(receipt.get("task_type") or "")) != proposal.get("intent")):
+        return None, None, "post_contract_mismatch"
+    artifacts = _load_artifacts(receipt_path, receipt)
+    if not _receipt_digest_matches(receipt_path, expected_sha256):
+        return None, None, "receipt_changed"
+    if not artifacts.get("valid"):
+        return receipt, None, "artifact_integrity_failed"
+    return receipt, artifacts, None
+
+
+def classify_after_publish(receipt_path: Path, *, merchant_id: str, post_slug: str = "") -> dict[str, Any]:
+    """Best-effort post-publication classification; never raises into publish success."""
+    credentials = classification_credentials()
+    if credentials is None:
+        return {"status": "unavailable", "reason": "auth_not_configured"}
+    try:
+        proposal = propose_receipt_classification(receipt_path, merchant_id=merchant_id)
+        if proposal.get("status") != "proposed":
+            return proposal
+        context_rows = fetch_classification_context(credentials, merchant_id, [proposal["post_id"]])
+        row = next((item for item in context_rows if item.get("post_id") == proposal["post_id"]), None)
+        if not row or not row.get("input_fingerprint"):
+            return {"status": "unavailable", "reason": "context_missing"}
+        from codex_content_agent.release_policy import _draft_matches_current_post
+        _receipt, artifacts, receipt_error = _load_approved_receipt_artifacts(
+            receipt_path, proposal=proposal, merchant_id=merchant_id
+        )
+        if receipt_error:
+            return {"status": "rejected", "reason": receipt_error}
+        if not artifacts or not _draft_matches_current_post(
+            artifacts.get("draft", {}),
+            {"slug": row.get("slug"), "title": row.get("title"),
+             "category": row.get("category"), "content": row.get("content")},
+        ):
+            return {"status": "rejected", "reason": "current_post_mismatch"}
+        if not _receipt_digest_matches(receipt_path, str(proposal.get("evidence_sha256") or "")):
+            return {"status": "rejected", "reason": "receipt_changed"}
+        result = set_classification(
+            credentials, merchant_id=merchant_id, post_id=proposal["post_id"],
+            intent=proposal["intent"], fingerprint=row["input_fingerprint"],
+            evidence_sha256=proposal["evidence_sha256"],
+        )
+        from codex_content_agent.blog_revalidation import revalidate_blog_cache
+        revalidation = revalidate_blog_cache([post_slug or str(row.get("slug") or "")])
+        return {"status": "classified", "result": result, "revalidation": revalidation}
+    except (OSError, ValueError, RuntimeError, urllib.error.URLError, urllib.error.HTTPError) as error:
+        return {"status": "unavailable", "reason": type(error).__name__}
