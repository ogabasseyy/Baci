+def _valid_receipt(root: Path) -> tuple[Path, dict[str, object]]:
+    run_dir = root / "trusted-run"
+    (run_dir / "assets").mkdir(parents=True)
+    image = b"test-image-bytes"
+    (run_dir / "assets/featured.png").write_bytes(image)
+    draft: dict[str, object] = {
+        "task_type": "product_support", "canonical_topic_key": "support:phone",
+        "target_product_ids": ["product-1"], "title": "Article", "category": "Phones",
+        "content_html": "<p>Body</p>", "relationship_intent": "primary",
+        "featured_image": {"path": "assets/featured.png"},
+    }
+    draft_bytes = json.dumps(draft, sort_keys=True).encode()
+    provenance = {"version": 1, "images": [{"path": "assets/featured.png",
+                  "sha256": hashlib.sha256(image).hexdigest(),
+                  "provenance_type": "generated_illustration", "product_ids": [],
+                  "source_urls": [], "license_status": "not_applicable"}]}
+    preflight_bytes = b'{"status":"ok"}'
+    guard_bytes = b'{"status":"ok"}'
+    provenance_bytes = (json.dumps(provenance, sort_keys=True) + "\n").encode()
+    for name, data in (("draft.json", draft_bytes), ("preflight.json", preflight_bytes),
+                       ("publish-guard.json", guard_bytes), ("image-provenance.json", provenance_bytes)):
+        (run_dir / name).write_bytes(data)
+    receipt = {
+        "version": 2, "run_id": run_dir.name, "post_id": "post-1", "merchant_id": "merchant-1",
+        "task_type": "product_support", "canonical_topic_key": "support:phone",
+        "target_product_ids": ["product-1"], "relationship_intent": "primary",
+        "draft_sha256": hashlib.sha256(draft_bytes).hexdigest(),
+        "preflight_sha256": hashlib.sha256(preflight_bytes).hexdigest(),
+        "publish_guard_sha256": hashlib.sha256(guard_bytes).hexdigest(),
+        "image_provenance_sha256": hashlib.sha256(provenance_bytes).hexdigest(),
+        "created_at": "2026-10-25T00:00:00Z",
+    }
+    receipt_path = run_dir / "release-receipt.json"
+    receipt_path.write_text(json.dumps(receipt))
+    return receipt_path, draft
+
