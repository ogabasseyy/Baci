--- a/cpp/views/RawPropsCompat.cpp
+++ b/cpp/views/RawPropsCompat.cpp
@@ -16,6 +16,14 @@
 
 #include "ReactNativeCore.hpp"
 
+// React Native 0.89+ (RN_STRICT_API) rejects direct includes of headers that have
+// an umbrella, and makes <cxxreact/ReactNativeVersion.h> private.
+#if __has_include(<React/Utils.h>)
+#include <React/Utils.h>
+#else
+#include <cxxreact/ReactNativeVersion.h>
+#endif
+
 #if defined(ANDROID) && REACT_NATIVE_VERSION_MAJOR == 0 && REACT_NATIVE_VERSION_MINOR >= 84 && REACT_NATIVE_VERSION_MINOR < 87
 #include <react/featureflags/ReactNativeFeatureFlags.h>
 #endif
