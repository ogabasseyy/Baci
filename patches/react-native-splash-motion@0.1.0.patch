+package com.margelo.nitro.splashmotion
+
+/** Access on the main thread; retain the first terminal result. */
+internal class IntroLatch {
+  private var result: Boolean? = null
+  private val waiters = mutableListOf<(Boolean) -> Unit>()
+
+  fun wait(done: (Boolean) -> Unit) {
+    val value = result
+    if (value != null) done(value) else waiters += done
+  }
+
+  fun finish(value: Boolean) {
+    if (result != null) return
+    result = value
+    val callbacks = waiters.toList()
+    waiters.clear()
+    callbacks.forEach { it(value) }
+  }
+}
