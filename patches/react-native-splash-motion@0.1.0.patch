+++ b/ios/IntroLatch.swift
@@ -0,0 +1,19 @@
+import Foundation
+
+/// Called only on the main thread; retains the first terminal result.
+final class IntroLatch {
+  private var result: Bool?
+  private var waiters: [(Bool) -> Void] = []
+
+  func wait(_ callback: @escaping (Bool) -> Void) {
+    if let result { callback(result) } else { waiters.append(callback) }
+  }
+
+  func finish(_ value: Bool) {
+    guard result == nil else { return }
+    result = value
+    let callbacks = waiters
+    waiters.removeAll()
+    callbacks.forEach { $0(value) }
+  }
+}
