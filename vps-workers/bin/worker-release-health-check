#!/usr/bin/env bash
# Fixed post-promotion health gate for the broker. This is installed root-owned.
set -euo pipefail

readonly root='/srv/baci-workers'
readonly expected="${1:-}"
[[ "$expected" =~ ^[0-9a-f]{40}$ ]] || exit 2
[[ -d "$root" && ! -L "$root" ]] || exit 1
[[ -L "$root/current" ]] || exit 1
[[ "$(readlink "$root/current")" == "releases/$expected" ]] || exit 1
[[ -d "$root/releases/$expected" && ! -L "$root/releases/$expected" ]] || exit 1

# These fixed services are the first release-managed system units. Missing or
# inactive units fail closed; the helper never accepts a service name from a caller.
for service in baci-domain-event-router baci-event-delivery-worker baci-quiz-finalization; do
  /usr/bin/systemctl is-active --quiet "$service"
done
