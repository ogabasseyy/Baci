#!/usr/bin/env python3
"""Fail-closed cron and systemd launch gate for worker release recovery."""
import os
import sys

from worker_release_recovery_latch import LatchError, service_allowed


def main(argv: list[str]) -> int:
    if not argv or argv[0] not in ("scheduled", "unit"):
        return 64
    mode = argv[0]
    if mode == "scheduled":
        service = "scheduled"
        command_index = 1
    else:
        if len(argv) < 2:
            return 64
        service = argv[1]
        command_index = 2
    check_only = command_index >= len(argv)
    if not check_only and argv[command_index] == "--":
        command_index += 1
    if mode == "unit":
        allowed = service_allowed(service)
    else:
        # Scheduled work is denied while the root-owned recovery latch exists.
        allowed = service_allowed("scheduled")
    if not allowed:
        return 0 if mode == "scheduled" and not check_only else 1
    if check_only:
        return 0
    if command_index >= len(argv):
        return 64
    os.execvpe(argv[command_index], argv[command_index:], os.environ)
    return 127


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    except LatchError:
        # Deny launches on malformed or untrusted latch state.
        raise SystemExit(1)
