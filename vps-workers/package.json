{
  "name": "baci-vps-workers",
  "version": "1.0.0",
  "type": "module",
  "description": "Standalone cron workers that run on the VPS to eliminate Vercel Fluid Compute costs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "cleanup-push-tokens": "node jobs/cleanup-push-tokens.mjs",
    "cleanup-import-uploads": "node jobs/cleanup-import-uploads.mjs",
    "cleanup-legacy-expense-receipts": "node jobs/cleanup-legacy-expense-receipts.mjs",
    "cleanup-private-expense-receipts": "node jobs/cleanup-private-expense-receipts.mjs",
    "supabase-retention-cleanup": "node jobs/supabase-retention-cleanup.mjs",
    "cleanup-agentic-request-records": "node jobs/cleanup-agentic-request-records.mjs",
    "cleanup-remediation-storage": "node jobs/cleanup-remediation-storage.mjs",
    "push-receipts": "node jobs/push-receipts.mjs",
    "sync-gigl-service-centres": "node jobs/sync-gigl-service-centres.mjs",
    "agentic-commerce-health": "node jobs/run-web-cron.mjs /api/cron/agentic-commerce-health",
    "inventory-push-alerts": "node jobs/run-web-cron.mjs /api/inventory/push-alerts",
    "reconcile-vtu-processing": "node jobs/run-web-cron.mjs /api/cron/reconcile-vtu-processing",
    "vtu-cashback-summaries": "node jobs/run-web-cron.mjs /api/cron/vtu-cashback-summaries",
    "sync-jumia-orders": "bash bin/sync-jumia-orders.sh",
    "process-gigl-tracking": "bash bin/process-gigl-tracking.sh",
    "process-petrock-reconciliation": "bash bin/process-petrock-reconciliation.sh",
    "process-quiz-finalization": "bash bin/process-quiz-finalization.sh",
    "preflight-direct-web-workers": "node jobs/preflight-direct-web-workers.mjs",
    "run-web-cron": "node jobs/run-web-cron.mjs",
    "ai-storefront-trigger-server": "node jobs/ai-storefront-trigger-server.mjs",
    "sentry-mobile-error-remediator": "node jobs/sentry-mobile-error-remediator.mjs",
    "vercel-error-remediator": "node jobs/vercel-error-remediator.mjs",
    "vercel-log-drain-receiver": "node jobs/vercel-log-drain-receiver.mjs",
    "test": "node scripts/run-tests.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.103.0",
    "dotenv": "^16.0.0",
    "expo-server-sdk": "^6.1.0"
  },
  "devDependencies": {
    "@typescript/typescript6": "~6.0.2"
  }
}
