[Unit]
Description=Baci read-only production release lock status
After=local-fs.target

[Service]
Type=simple
User=root
Group=root
RuntimeDirectory=baci-worker-release-status
RuntimeDirectoryMode=0711
RuntimeDirectoryPreserve=no
ExecStart=/usr/bin/python3 /usr/local/lib/baci-worker-broker/production_release_lock_status.py serve
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=/home/baci-release/.local/state/baci:/run/baci-worker-release-status/lock-state
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
