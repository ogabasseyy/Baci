[Unit]
Description=Baci quiz deadline finalizer
After=network-online.target baci-worker-release-broker.service
Wants=network-online.target
BindsTo=baci-worker-release-broker.service

[Service]
Type=simple
User=baci-worker
Group=baci-worker
WorkingDirectory=/srv/baci-workers/current
Environment=HOME=/srv/baci-workers/home
Environment=NODE_ENV=production
Environment=BACI_WORKER_PROFILE=quiz-finalization
Environment=BACI_REPO_DIR=/srv/baci-workers/current
Environment=BACI_WORKER_ENV=/srv/baci-workers/runtime/worker.env
ExecCondition=/usr/local/lib/baci-worker-broker/worker-release-launch-gate unit baci-quiz-finalization
ExecStart=/usr/bin/flock -n /srv/baci-workers/locks/quiz-finalize.lock /srv/baci-workers/current/bin/process-quiz-finalization.sh --loop
Restart=always
RestartSec=1
KillMode=control-group
TimeoutStopSec=2
StandardOutput=append:/srv/baci-workers/logs/quiz-finalize.log
StandardError=append:/srv/baci-workers/logs/quiz-finalize.log
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/baci-workers/locks /srv/baci-workers/logs

[Install]
WantedBy=multi-user.target
